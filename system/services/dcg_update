#!/bin/bash
# dcg_update : au démarrage, compare la version locale à celle du dépôt
# et relance install.sh si une version plus récente existe.

REPO_RAW="https://raw.githubusercontent.com/DreamerCG/linuxloader/main"
VERSION_FILE="/userdata/system/dcg/VERSION"
LOG="/userdata/system/logs/dcg_update.log"
BATOCERA_CONF="/userdata/system/batocera.conf"
TEKNOPARROT_ROMS="/userdata/roms/teknoparrot"
LINUXLOADER_DIR="/userdata/system/dcg/emulators/linuxloader"

log() { echo "$(date '+%F %T') $*" >> "$LOG"; }

version_gt() {   # vrai si $1 > $2
    [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" = "$1" ]
}

# Ajoute une valeur par jeu sans écraser une éventuelle préférence utilisateur.
conf_add_game_setting() {
    local game="$1" setting="$2" value="$3"
    local key="teknoparrot[\"$game\"].$setting"

    if awk -v prefix="$key=" 'index($0, prefix) == 1 { found = 1 } END { exit !found }' "$BATOCERA_CONF"; then
        return 1
    fi
    [ -s "$BATOCERA_CONF" ] && [ -n "$(tail -c 1 "$BATOCERA_CONF")" ] && printf '\n' >> "$BATOCERA_CONF"
    printf '%s=%s\n' "$key" "$value" >> "$BATOCERA_CONF"
    return 0
}

scan_teknoparrot_roms() {
    if [ ! -d "$TEKNOPARROT_ROMS" ]; then
        log "dossier TeknoParrot introuvable : $TEKNOPARROT_ROMS"
        echo "Dossier introuvable : $TEKNOPARROT_ROMS"
        return 0
    fi
    mkdir -p "$(dirname "$BATOCERA_CONF")"
    mkdir -p "$(dirname "$LOG")"
    [ -f "$BATOCERA_CONF" ] || touch "$BATOCERA_CONF"

    local added=0 skipped=0 rom name emulator core
    while IFS= read -r -d '' rom; do
        name="${rom##*/}"
        case "$name" in
            *.squashfs) emulator="linuxloader-dcg"; core="linuxloader-dcg" ;;
            *.wsquashfs) emulator="wine"; core="wine-tkg" ;;
            *) continue ;;
        esac

        if conf_add_game_setting "$name" emulator "$emulator"; then
            added=$((added + 1))
        else
            skipped=$((skipped + 1))
        fi
        if conf_add_game_setting "$name" core "$core"; then
            added=$((added + 1))
        else
            skipped=$((skipped + 1))
        fi
    done < <(find "$TEKNOPARROT_ROMS" -maxdepth 1 -type f \( -name '*.squashfs' -o -name '*.wsquashfs' \) -print0 2>/dev/null)

    log "scan TeknoParrot terminé : $added réglage(s) ajouté(s), $skipped déjà défini(s)"
    echo "Scan TeknoParrot terminé : $added réglage(s) ajouté(s), $skipped déjà défini(s)."
}

fix_linuxloader_permissions() {
    [ -d "$LINUXLOADER_DIR" ] || return 0
    find "$LINUXLOADER_DIR" -type f -name '*.so' -exec chmod a+x {} + 2>/dev/null
    local result=$?
    if [ "$result" -eq 0 ]; then
        log "permissions exécutables appliquées aux bibliothèques .so de LinuxLoader"
    else
        log "ÉCHEC de l'application des permissions aux bibliothèques .so de LinuxLoader"
    fi
    return 0
}

check_update() {
    mkdir -p "$(dirname "$LOG")"

    # attend le réseau (~60 s max)
    echo "Vérification de la version distante..."
    remote=""
    for _ in $(seq 1 30); do
        remote="$(curl -fs --max-time 5 "$REPO_RAW/VERSION" | tr -d '[:space:]')"
        [ -n "$remote" ] && break
        sleep 2
    done
    if [ -z "$remote" ]; then
        log "version distante injoignable après 30 tentatives"
        echo "Mise à jour impossible : version distante injoignable. Consulte $LOG"
        return 1
    fi

    local_v="$(tr -d '[:space:]' < "$VERSION_FILE" 2>/dev/null)"
    local_v="${local_v:-0}"
    log "locale=$local_v distante=$remote"
    echo "Version installée : $local_v ; version distante : $remote"

    if version_gt "$remote" "$local_v"; then
        log "mise à jour vers $remote"
        echo "Mise à jour vers $remote..."
        if curl -fsL --retry 3 "$REPO_RAW/install.sh" -o /tmp/dcg_install.sh; then
            if DCG_NONINTERACTIVE=1 bash /tmp/dcg_install.sh >> "$LOG" 2>&1; then
                log "mise à jour terminée"
                echo "Mise à jour terminée."
            else
                log "ÉCHEC de l'installation"
                echo "Échec de l'installation. Consulte $LOG"
                rm -f /tmp/dcg_install.sh
                return 1
            fi
        else
            log "téléchargement de install.sh impossible"
            echo "Téléchargement de install.sh impossible. Consulte $LOG"
            return 1
        fi
        rm -f /tmp/dcg_install.sh
    else
        log "aucune mise à jour nécessaire"
        echo "Aucune mise à jour nécessaire."
    fi
}

main() {
    case "$1" in
        start)
            # En arrière-plan : ne bloque pas le boot. Le scan passe avant
            # l'éventuelle mise à jour qui peut elle aussi modifier batocera.conf.
            ( scan_teknoparrot_roms; fix_linuxloader_permissions; check_update ) >/dev/null 2>&1 &
            ;;
        scan)   scan_teknoparrot_roms; fix_linuxloader_permissions ;;
        update)
            scan_teknoparrot_roms
            fix_linuxloader_permissions
            check_update
            ;;
        stop)   ;;
        status) cat "$VERSION_FILE" 2>/dev/null || echo "inconnue" ;;
        *)      scan_teknoparrot_roms; fix_linuxloader_permissions; check_update ;;
    esac
}

main "$@"
exit 0
