def _detect_batocera_version() -> int | None:

    try:
        result = subprocess.run(
            ["batocera-es-swissknife", "--version"],
            capture_output=True, text=True, check=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return None

    m = re.search(r"^\s*(\d+)", result.stdout)
    if not m:
        return None
    return int(m.group(1))

def _new_get_generator(emulator: str, core: str | None = None):
    
    print(f"Selected emulator: {emulator}", file=sys.stderr)    
    print(f"Selected Rom : {rom}", file=sys.stderr)    
    print(f"Selected Core : {core}", file=sys.stderr)    

    if emulator == 'play':
        from generators.namco2x6.playGenerator import PlayGenerator
        return PlayGenerator()
		
    if emulator == 'rpcs3':
        from generators.rcps3.rpcs3Generator import Rpcs3Generator
        return Rpcs3Generator()		

    if emulator == 'wine':
        from generators.wine.wineGenerator import WineGenerator
        return WineGenerator()    

    if emulator == 'demul':
        from generators.demul.demulGenerator import DemulGenerator
        return DemulGenerator()

    if emulator == 'shadps4':
        from generators.shadps4.shadPS4Generator import shadPS4Generator
        return shadPS4Generator()

    if emulator == 'linuxloader':
        from generators.linuxloader.linuxloaderGenerator import LinuxloaderGenerator
        return LinuxloaderGenerator()

    # ==========================================
    # FALLBACK TO BATOCERA
    # ==========================================

    if "-system" in sys.argv:
        sys.argv[sys.argv.index("-system") + 1] = "windows"
        print(
            "Fallback to Batocera generator: forcing system=windows",
            file=sys.stderr
        )
        system_name = sys.argv[sys.argv.index("-system") + 1]
        print("Debug System :", system_name, file= sys.stderr)

    return get_generator(emulator)

from configgen.batoceraPaths import DEFAULTS_DIR
configgen.emulatorlauncher.get_generator = _new_get_generator

if __name__ == "__main__":

