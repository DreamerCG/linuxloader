Windows Registry Editor Version 5.00

; Need for Speed Carbon's cabinet (its install discs' Registry folder): the frontend's settings,
; the game it starts (the original build, in the run directory), the Hercules monitors' settings
; (not their boot entry), the cabinet's game root, version and database schema paths.

[HKEY_CURRENT_USER\Software\Anark\Client\3.0\Preferences]
"InstallReturnCode"=dword:00000000
"Initialized"=dword:00000001
"UpdateInterval"=dword:00000007
"LastUpdateCheck"=dword:00000122
"EnableScriptDebugger"=dword:00000001
"DebugMode"=dword:00000000
"DisableGL"="1"

[HKEY_LOCAL_MACHINE\SOFTWARE\GlobalVR\CARBON]
"CommVersion"="1.0.1"
"cmd"=""
"wtf"=""
"launchName"="CarbonReleaseorig.exe"
"launchFolder"="C:\\wal\\globalvr\\need-for-speed-carbon"
"attractName"="CARBON_Attract.am"
"attractFolder"="C:\\shell"
"selectName"="CARBON_Selection.am"
"selectFolder"="C:\\shell"
"AttractAudioCounter"="0"
"ShellVolume" = "50"
"MusicVolume" = "80"
"LoginTimeouts" = "0"
"CareerLoginContinue" = "0"
"CareerNumber" = "0"
"CareerPath" = "0"
"CareerIndex" = "0"
"CareerTries" = "0"
"LoginMethod" = "0"
"LoginTimeouts" = "0"
"PlayerName" = "0"
"SelectedAI" = "1"
"CarCustomized" = "0"
"SelectedCar" = "0"
"LobbyTimerAdjustment" = "0"
"FirstTimeStartup"="0"

[HKEY_LOCAL_MACHINE\SOFTWARE\GVR\hercules]

; CoinMeterMasks added 12/7/05 to support updated GvrCoinMonitor
[HKEY_LOCAL_MACHINE\SOFTWARE\Gvr\hercules\GVRCoinMonitor]
"CoinMeterMask1"=dword:00000000
"CoinMeterMask2"=dword:00000004

[HKEY_LOCAL_MACHINE\SOFTWARE\Gvr\hercules\GVRCacheWarmer]
"NumResources"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Gvr\hercules\GVRCrashMonitor]
"NumApps"=dword:00000008
"SleepDelay"=dword:00000064

[HKEY_LOCAL_MACHINE\SOFTWARE\Gvr\hercules\GVRCrashMonitor\Prog00]
"cmdargs"=""
"delay"=dword:00000064
"enabled"=dword:00000003
"path"="c:\\hercules"
"program"="GVRDongleMonitor.exe"

[HKEY_LOCAL_MACHINE\SOFTWARE\Gvr\hercules\GVRCrashMonitor\Prog01]
"cmdargs"=" "
"delay"=dword:00000064
"enabled"=dword:00000001
"path"="c:\\hercules"
"program"="GVRCoinMonitor.exe"

[HKEY_LOCAL_MACHINE\SOFTWARE\Gvr\hercules\GVRCrashMonitor\Prog02]
"cmdargs"=""
"delay"=dword:00000064
"enabled"=dword:00000001
"path"="c:\\hercules"
"program"="GVRStallMonitor.exe"

[HKEY_LOCAL_MACHINE\SOFTWARE\Gvr\hercules\GVRCrashMonitor\Prog03]
"cmdargs"=""
"delay"=dword:00000064
"enabled"=dword:00000000
"path"="c:\\hercules"
"program"="GVRCacheWarmer.exe"

[HKEY_LOCAL_MACHINE\SOFTWARE\Gvr\hercules\GVRCrashMonitor\Prog04]
"cmdargs"="-minvol -1500"
"delay"=dword:00007530
"enabled"=dword:00000001
"path"="c:\\Shell\\bin"
"program"="AMPlayer.exe c:\\Shell\\shell.am -v FULL -cabinet"

[HKEY_LOCAL_MACHINE\SOFTWARE\Gvr\hercules\GVRCrashMonitor\Prog05]
"cmdargs"=""
"delay"=dword:00000096
"enabled"=dword:00000001
"path"="c:\\hercules"
"program"="GvrCoinSound.exe"

[HKEY_LOCAL_MACHINE\SOFTWARE\Gvr\hercules\GVRCrashMonitor\Prog06]
"cmdargs"=" "
"delay"=dword:00000096
"enabled"=dword:00000001
"path"="c:\\hercules"
"program"="GVRVolumeMonitor.exe"

[HKEY_LOCAL_MACHINE\SOFTWARE\Gvr\hercules\GVRCrashMonitor\Prog07]
"cmdargs"=" "
"delay"=dword:00000096
"enabled"=dword:00000001
"path"="C:\\GvrPlus\\PeerToPeer"
"program"="PeerToPeerProcess.exe"

[HKEY_LOCAL_MACHINE\SOFTWARE\Gvr\hercules\GVRCoinSound\Sound]
"SoundPath"="c:\\hercules\\coin_drop.wav"

[HKEY_LOCAL_MACHINE\SOFTWARE\Gvr\Plus\2.0\Cabinet]
"GameRoot"="C:\\"

[HKEY_LOCAL_MACHINE\SOFTWARE\GlobalVR\CARBON]
"Version"="1.0.0"
"Build"="151"
"Prefix"=""
"Suffix"=""
; the last session's up time, read at startup (not on a first startup: FirstTimeStartup is 0)
"UpTimeStart"="1/1/2008 12:00:00 AM"
"UpTimeEnd"="1/1/2008 12:00:00 AM"

[HKEY_LOCAL_MACHINE\SOFTWARE\gvr\Plus\1.1\Cabinet]
"GvrEventLogRemovalThreshold"="30"
"MaxObjectLoadCount"="300"
"PatchDownloadPath"="C:\\PatchService\\"
"PatchMaxDownloadRetry"="9"
"PatchMaxExecutionRetry"="1"
"PlayerCardRequestThreshold"="20"
"PlusSchemaPath"="C:\\Gvr\\schema\\CarbonCabinetXml.enc"
"PromotionPath"="C:\\GvrPlus\\4\\promotions"
"PublicKeyPath"="C:\\GvrPlus\\4\\key\\publickey.xml"
"SyncRetryInterval"="15"
"WebServerIP"="192.168.1.39"
